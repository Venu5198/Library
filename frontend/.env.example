# Frontend environment variables
# Prefix VITE_ makes variables available to browser-side code
# All other variables are build-time only

# Backend API URL — configure for your environment
# Local development: http://localhost:8080
# Docker Compose (browser access): http://localhost:8080
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8080

# Application metadata
VITE_APP_NAME=MyPlatform
VITE_APP_VERSION=1.0.0
