# Infrastructure / Docker Compose environment
# Copy to .env and customize for your local setup

# ── Service URLs (for host access) ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
VERDACCIO_URL=http://localhost:4873
MONGO_EXPRESS_URL=http://localhost:8081
MONGODB_LOCAL=mongodb://localhost:27017

# ── Build args ───────────────────────────────────────────────────────────────
# VITE_API_URL is baked into the frontend build
# Change this if your backend URL is different
VITE_API_URL=http://localhost:8080

# ── Mongo Express credentials (local dev only) ───────────────────────────────
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin123
